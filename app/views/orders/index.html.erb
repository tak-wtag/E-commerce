<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-5 fw-bold">Your Orders</h1>
    <% if logged_in? %>
        <div class="d-flex flex-column gap-2">
            <%= button_to "Log Out", logout_path, method: :delete, class: "btn btn-danger"%>
        </div>
    <%else%>
        <%= link_to "Log In", sessions_new_path, class: "btn btn-success" %>
    <% end %>
  </div>
  <div class="card shadow-sm">
    <div class="card-body">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Product</th>
            <th>Date Ordered</th>
            <th>Quantity</th>
            <th>Status</th>
            <th>Details</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr>
              <td><%= order.product.title %></td>
              <td><%= order.created_at.strftime("%B %d, %Y") %></td>
              <td><%= order.quantity %></td>
              <td><span class="badge bg-primary"><%= order.status %></span></td>
              <td><%= link_to "View Details", order_path(order), class: "btn btn-sm btn-info" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>