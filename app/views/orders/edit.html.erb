<%# app/views/orders/new.html.erb %>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-6">
      <h2>Edit Order for <%= @order.product.title %></h2>
      <div class="d-flex flex-column gap-2">
            <%= link_to "Log Out", logout_path, method: :delete, class: "btn btn-danger"%>
      </div>
      <div class="card mt-4">
        <div class="card-body">
          <%= form_with model: [@product, @order], local: true do |form| %>
            <% if @order.errors.any? %>
              <div class="alert alert-danger">
                <% @order.errors.full_messages.each do |message| %>
                  <div><%= message %></div>
                <% end %>
              </div>
            <% end %>

            <div class="form-group mb-3">
              <%= form.label :quantity %>
              <%= form.number_field :quantity, class: "form-control", value: 1 %>
            </div>

            <div class="form-group mb-3">
              <%= form.label :address, "Shipping Address" %>
              <%= form.text_area :address, class: "form-control" %>
            </div>
            
            <div class="form-group mb-3">
              <%= form.label :criteria, "Special Instructions (optional)" %>
              <%= form.text_field :criteria, class: "form-control" %>
            </div>

            <%= form.submit "Confirm Order", class: "btn btn-success" %>
            <%= link_to "Cancel", @product, class: "btn btn-secondary" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>