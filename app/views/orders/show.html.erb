<div class="container mt-5">
  <h1 class="display-5 fw-bold mb-4">Order Details</h1>
  <div class="card shadow-sm">
    <div class="card-body p-4">
      <h5 class="card-title">Product: <%= @order.product.title %></h5>
      <p class="card-text"><strong>Order Date:</strong> <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
      <p class="card-text"><strong>Quantity:</strong> <%= @order.quantity %></p>
      <p class="card-text"><strong>Status:</strong> <span class="badge bg-primary"><%= @order.status %></span></p>

      <hr class="my-4">

      <h5 class="card-title">Seller Information</h5>
      <p class="card-text"><strong>Seller_name:</strong> <%= @order.product.user.username %></p>

      <div class="mt-4 d-flex justify-content-between">
        <%= link_to "Back to All Orders", orders_path, class: "btn btn-secondary" %>  
        <div class="d-flex gap-2">
            <%= link_to "Edit", edit_order_path(@order), class: "btn btn-warning" %>
            <%= button_to "Delete", @order, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
            <%= button_to "Log Out", logout_path, method: :delete, class: "btn btn-danger"%>
        </div>
      </div>
    </div>
  </div>
</div>