<!DOCTYPE html>
<html>
<head>
  <style>
    @import url('https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css');
  </style>
</head>
<body class="bg-gray-100 font-sans leading-normal tracking-normal">
  <div class="max-w-lg mx-auto my-10 bg-white p-8 rounded-lg shadow-lg">
    <h1 class="text-2xl font-bold mb-4">You've Received a New Order! 🚀</h1>
    <p class="text-lg mb-4">
      Hi, <%= @user.username %>!
    </p>
    <p class="text-lg mb-4">
      You have a new order for your product: <strong class="text-blue-500"><%= @product.title %></strong>.
    </p>
    <p class="text-lg">
      <strong>Quantity Ordered:</strong> <%= @order.quantity %>
    </p>
    <p class="text-lg mt-4">
      You can view the full order details here: <%= link_to "View Order", received_order_url(@order) %>
    </p>
  </div>
</body>
</html>