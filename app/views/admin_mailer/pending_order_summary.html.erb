<!DOCTYPE html>
<html>
<head>
  <style>
    @import url('https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css');
  </style>
</head>
<body class="bg-gray-100 font-sans leading-normal tracking-normal">
  <div class="max-w-lg mx-auto my-10 bg-white p-8 rounded-lg shadow-lg">
    <h1 class="text-2xl font-bold mb-4">Your Daily Summary is ready! 🚀</h1>
    <p class="text-lg mb-4">
      Hi, <%= @seller.username %>!
    </p>
    <p class="text-lg mb-4">
      This is your daily summary from the app.
      You currently have <strong class="text-blue-500"><%= @order_count %> </strong> pending orders.
      Please log in to see them.
      Have a great day!
    </p>
  </div>
</body>
</html>