<!DOCTYPE html>
<html>
<head>
  <style>
    @import url('https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css');
  </style>
</head>
<body class="bg-gray-100 font-sans leading-normal tracking-normal">
  <div class="max-w-lg mx-auto my-10 bg-white p-8 rounded-lg shadow-lg">
    <h1 class="text-2xl font-bold mb-4">Verify your account</h1>
    <p class="text-lg mb-4">Hi, <%= @user.username %>!</p>
    <p class="text-lg mb-4">You have received one order <strong class="text-blue-500"></strong></p>
    <p class="text-lg">Click here to see order details <%= link_to "Verify Account", @url %></p>
  </div>
</body>
</html>
