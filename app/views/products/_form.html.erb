<% if @product.errors.any? %>
  <div class="alert alert-danger">
    <% @product.errors.full_messages.each do |message| %>
      <div><%= message %></div>
    <% end %>
  </div>
<% end %>

<%= form_with model: @product, local: true do |form| %>
  <div class="form-group row mt-3">
    <%= form.label :title %>
    <%= form.text_field :title, class: "form-control", placeholder: "Enter product title" %>
  </div>

  <div class="form-group row mt-3">
    <%= form.label :price %>
    <%= form.number_field :price, class: "form-control", placeholder: "99" %>
  </div>

  <div class="form-group row mt-3">
    <%= form.label :picture, "Upload Image" %>
    <%= form.file_field :picture, class: "form-control" %>
  </div>

  <div class="form-group row mt-3">
    <div class="form-check">
      <%= form.check_box :availability, class: "form-check-input" %>
      <%= form.label :availability, class: "form-check-label" %>
    </div>
  </div>

  <div class="form-group row mt-3">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>